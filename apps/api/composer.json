{
  "name": "senkom/api",
  "description": "SENKOM Phase 0 Laravel API foundation",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.4.0",
    "laravel/framework": "^13.39.0",
    "opis/json-schema": "^2.6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "dev": "@php artisan serve --host=127.0.0.1 --port=8000",
    "lint": "@php tools/lint.php",
    "test": "@php vendor/phpunit/phpunit/phpunit",
    "check": [
      "@lint",
      "@test",
      "@php artisan route:list --path=api"
    ]
  },
  "config": {
    "platform": {
      "php": "8.4.26"
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
