{
  "name": "senkom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SENKOM Phase 0 foundation; demo only",
  "workspaces": [
    "apps/desktop",
    "apps/admin-web",
    "packages/*"
  ],
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "npm run dev --workspace @senkom/desktop",
    "dev:cache": "npm run dev:cache --workspace @senkom/desktop",
    "dev:admin": "npm run dev --workspace @senkom/admin-web",
    "dev:api": "composer --working-dir apps/api dev",
    "admin:configure": "node scripts/configure-admin.mjs",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "typecheck": "tsc --noEmit && tsc -p apps/desktop/tsconfig.main.json --noEmit",
    "lint": "eslint . && prettier . --check && npm run contracts:check",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:gateway:e2e": "node scripts/phase3-gateway-browser-e2e.mjs",
    "test:parent3-02:e2e": "powershell -NoProfile -File scripts/phase3-parent-browser-e2e.ps1",
    "build": "npm run contracts:check && npm run typecheck && npm run build --workspaces --if-present",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "check:api": "composer --working-dir apps/api check",
    "check": "npm run lint && npm run test && npm run build && npm run check:api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
